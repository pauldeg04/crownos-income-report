rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Public visitor booking requests.
       Writes now happen ONLY through the submitBookingRequest Cloud
       Function (Admin SDK, bypasses these rules) — see
       Income Report/functions/index.js. It validates shape, checks live
       capacity, and creates the matching scheduleHolds doc in the same
       transaction, none of which a client-side rules whitelist could do
       safely. Visitors therefore get no direct read/write access at all.
       Staff (authenticated) may list/read pending requests and update
       only the review fields when converting/declining one. */
    match /bookingRequests/{requestId} {

      allow create: if false;

      allow get, list: if request.auth != null;

      /* resource.data.status == 'pending' is the actual double-conversion
         guard: Firestore serializes writes to a single document and
         evaluates rules against its state immediately before each write
         commits, so of two staff racing to convert/decline the SAME
         request, whichever write lands first flips status away from
         'pending' and the second is rejected by this same check — no
         client-side transaction needed. See scheduling.js
         markBookingRequestConverted() / booking-requests.js
         declineRequest(), both of which now handle that rejection as
         "someone else already handled this request" instead of silently
         double-booking or double-declining. */
      allow update: if request.auth != null &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'convertedScheduleId']) &&
        request.resource.data.status in ['converted', 'declined'];

      allow delete: if false;
    }

    /* Tentative capacity holds created by submitBookingRequest and
       cleared by releaseExpiredHolds / releaseHoldOnRequestReview (see
       Income Report/functions/index.js). Staff (CrownOS) may read them to
       show hold status next to a pending request; only Functions write. */
    match /scheduleHolds/{holdId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /* Server-created staff notifications (see
       notifyReceptionistsOnNewBookingRequest in
       Income Report/functions/index.js) — a plain per-doc collection,
       separate from the client-owned "crownNotifications" list mirrored
       under appData, since only Functions (Admin SDK) ever write here.
       A signed-in staff member may only see/touch notifications addressed
       to their own synthetic sync email (recipientEmail), and may only
       ever flip the "read" flag. */
    match /staffNotifications/{notificationId} {
      allow create: if false;

      allow get, list: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail;

      allow update: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    /* Existing staff data-sync collection (firebase-sync.js mirrors every
       crown*-prefixed localStorage key here, one doc per key, split into
       __c0/__c1/... chunks past ~900KB — see appData.js/firebase-sync.js
       chunkDocRef()). Readable/writable by any authenticated user
       regardless of CrownOS role — access-control.js's PAGE_ACCESS gate
       is enforced only in the browser UI, so this was never full parity
       with per-page/per-role restrictions (appData values are opaque
       JSON strings, not structured fields rules can inspect) — but see
       /appDataCashflow below for the one key that previously carried an
       actual role-gated exception here.

       That exception used to live inline in this same rule
       (docId.matches('^crownCashflow_.*') ? Admin/EA only : anyone).
       Moved out because Firestore rejects an ENTIRE list query if it
       COULD return even one document the caller isn't allowed to read
       — the generic appData sync pull is exactly such an unfiltered
       collection query, run by every role on every login, so mixing an
       Admin/EA-only document into the same collection meant every
       non-Admin/EA account failed the very first pull of every fresh
       session, regardless of how correctly their role claim was set.
       Splitting cashflow into its own collection with its own rule
       lets this one stay simple and safe for a blanket query again.

       Other high-sensitivity keys (crownUserAccounts — holds password
       hashes for ALL staff, and the data-protection.html backup/restore
       surface, which is really "read access to everything") are
       DELIBERATELY NOT restricted: account-settings.js's
       CrownAuth.getUsers() needs the full crownUserAccounts array for
       EVERY role (each user's own password-change flow compares against
       it), so a blanket Admin-only rule on that key would break
       everyone's Account Settings page today, and would reintroduce
       the exact same unfiltered-list-query problem cashflow just got
       moved out of. Closing that gap needs an actual data-model change
       (e.g. stripping passwordHash out of what non-Admin sessions can
       read, in its own collection) before a rule can safely enforce it
       — tracked as a follow-up, not done here. */
    match /appData/{docId} {
      allow read, write: if request.auth != null;
    }

    /* crownCashflow_* data, split out of appData into its own
       collection (see the diagMigrateCashflow migration). The generic
       appData sync pull is an unfiltered collection query run by every
       role — Firestore rejects an ENTIRE list query if it could return
       even one document the caller isn't allowed to read, so mixing an
       Admin/EA-only exception into that same collection meant every
       other role failed the very first pull of every fresh session,
       no matter how correctly their role claim was set. Keeping
       cashflow in its own collection with its own straightforward rule
       lets appData go back to being safely readable by anyone
       authenticated, with no per-document exception for the query
       engine to worry about. */
    match /appDataCashflow/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }
  }
}
