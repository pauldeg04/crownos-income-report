rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Public visitor booking requests.
       Writes now happen ONLY through the submitBookingRequest Cloud
       Function (Admin SDK, bypasses these rules) — see
       Income Report/functions/index.js. It validates shape, checks live
       capacity, and creates the matching scheduleHolds doc in the same
       transaction, none of which a client-side rules whitelist could do
       safely. Visitors therefore get no direct read/write access at all.
       Staff (authenticated) may list/read pending requests and update
       only the review fields when converting/declining one. */
    match /bookingRequests/{requestId} {

      allow create: if false;

      allow get, list: if request.auth != null;

      /* resource.data.status == 'pending' is the actual double-conversion
         guard: Firestore serializes writes to a single document and
         evaluates rules against its state immediately before each write
         commits, so of two staff racing to convert/decline the SAME
         request, whichever write lands first flips status away from
         'pending' and the second is rejected by this same check — no
         client-side transaction needed. See scheduling.js
         markBookingRequestConverted() / booking-requests.js
         declineRequest(), both of which now handle that rejection as
         "someone else already handled this request" instead of silently
         double-booking or double-declining. */
      allow update: if request.auth != null &&
        resource.data.status == 'pending' &&
        (
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'convertedScheduleId']) &&
          request.resource.data.status in ['converted', 'declined'])
          ||
          /* Receptionists log contact-attempt notes on a request while it is
             still pending, ahead of converting or declining it — see
             addRemark() in booking-requests.js. */
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['remarks'])
        );

      allow delete: if false;
    }

    /* Tentative capacity holds created by submitBookingRequest and
       cleared by releaseExpiredHolds / releaseHoldOnRequestReview (see
       Income Report/functions/index.js). Staff (CrownOS) may read them to
       show hold status next to a pending request; only Functions write. */
    match /scheduleHolds/{holdId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /* Server-created staff notifications (see
       notifyReceptionistsOnNewBookingRequest in
       Income Report/functions/index.js) — a plain per-doc collection,
       separate from the client-owned "crownNotifications" list mirrored
       under appData, since only Functions (Admin SDK) ever write here.
       A signed-in staff member may only see/touch notifications addressed
       to their own synthetic sync email (recipientEmail), and may only
       ever flip the "read" flag. */
    match /staffNotifications/{notificationId} {
      allow create: if false;

      allow get, list: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail;

      allow update: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    /* Existing staff data-sync collection (firebase-sync.js mirrors every
       crown*-prefixed localStorage key here, one doc per key, split into
       __c0/__c1/... chunks past ~900KB — see appData.js/firebase-sync.js
       chunkDocRef()). Readable/writable by any authenticated user
       regardless of CrownOS role — access-control.js's PAGE_ACCESS gate
       is enforced only in the browser UI, so this was never full parity
       with per-page/per-role restrictions (appData values are opaque
       JSON strings, not structured fields rules can inspect) — but see
       /appDataCashflow below for the one key that previously carried an
       actual role-gated exception here.

       That exception used to live inline in this same rule
       (docId.matches('^crownCashflow_.*') ? Admin/EA only : anyone).
       Moved out because Firestore rejects an ENTIRE list query if it
       COULD return even one document the caller isn't allowed to read
       — the generic appData sync pull is exactly such an unfiltered
       collection query, run by every role on every login, so mixing an
       Admin/EA-only document into the same collection meant every
       non-Admin/EA account failed the very first pull of every fresh
       session, regardless of how correctly their role claim was set.
       Splitting cashflow into its own collection with its own rule
       lets this one stay simple and safe for a blanket query again.

       Other high-sensitivity keys (crownUserAccounts — holds password
       hashes for ALL staff, and the data-protection.html backup/restore
       surface, which is really "read access to everything") are
       DELIBERATELY NOT restricted: account-settings.js's
       CrownAuth.getUsers() needs the full crownUserAccounts array for
       EVERY role (each user's own password-change flow compares against
       it), so a blanket Admin-only rule on that key would break
       everyone's Account Settings page today, and would reintroduce
       the exact same unfiltered-list-query problem cashflow just got
       moved out of. Closing that gap needs an actual data-model change
       (e.g. stripping passwordHash out of what non-Admin sessions can
       read, in its own collection) before a rule can safely enforce it
       — tracked as a follow-up, not done here. */
    match /appData/{docId} {
      allow read, write: if request.auth != null;
    }

    /* crownCashflow_* data, split out of appData into its own
       collection (see the diagMigrateCashflow migration). The generic
       appData sync pull is an unfiltered collection query run by every
       role — Firestore rejects an ENTIRE list query if it could return
       even one document the caller isn't allowed to read, so mixing an
       Admin/EA-only exception into that same collection meant every
       other role failed the very first pull of every fresh session,
       no matter how correctly their role claim was set. Keeping
       cashflow in its own collection with its own straightforward rule
       lets appData go back to being safely readable by anyone
       authenticated, with no per-document exception for the query
       engine to worry about. */
    match /appDataCashflow/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    /* BIR Compliance Desk — same reasoning as appDataCashflow above: its
       own collection, not a key inside appData, so the blanket "any
       authenticated user" query on appData never has to account for a
       restricted document mixed in. */
    match /birCompliance/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    /* --- Admin Hub collections --- */

    /* Single-slot announcement, doc id always "current". Only Admin may
       publish/overwrite; everyone authenticated may read it. */
    match /announcement/{docId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
      allow delete: if false;
    }

    /* Archived announcements, one doc per "Send to Archive" action (see
       admin-announcement.js). Admin/Executive Assistant only, both to
       write and to browse the archive — matches the current announcement
       collection's editor permissions. */
    match /announcementArchive/{docId} {
      allow create: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
      allow get, list: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
      allow update, delete: if false;
    }

    /* Memo mailbox. Admin/Executive Assistant compose, edit, and delete;
       any authenticated recipient may acknowledge by writing ONLY their
       own key (their sync email, request.auth.token.email) under
       acknowledgements. Reads are blanket-authenticated (see appData note
       above for why Firestore rules can't cleanly filter "sender OR
       array-contains(recipients)" as a read condition) — the client
       queries narrowly, this rule just can't enforce that narrowing
       itself. */
    match /memos/{memoId} {
      allow create: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
      allow get, list: if request.auth != null;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgements']) &&
        request.resource.data.acknowledgements.diff(resource.data.get('acknowledgements', {}))
          .affectedKeys().hasOnly([request.auth.token.email]);
      allow update: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
      allow delete: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    /* Leave requests. A staff member creates their own Pending request
       (requesterEmail must match their own sync email). Any authenticated
       user may flip Pending->Processing (opening the review modal) or
       Processing->Approved/Declined — this is intentionally NOT restricted
       to Admin/Executive Assistant/Team Leader at the rules level, because
       "Team Leader" is a boolean flag on the account record, not a Firebase
       Auth custom claim, so rules cannot see it; access is gated in the
       CrownOS UI instead (accepted gap, see WORK_LOG.md). The requester
       may cancel their own still-open request. */
    match /leaveRequests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.requesterEmail == request.auth.token.email &&
        request.resource.data.status == 'Pending';
      allow get, list: if request.auth != null;
      allow update: if request.auth != null && (
        (resource.data.status == 'Pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processingAt', 'processingBy']) &&
          request.resource.data.status == 'Processing')
        ||
        (resource.data.status == 'Processing' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']) &&
          request.resource.data.status in ['Approved', 'Declined'])
        ||
        (resource.data.requesterEmail == request.auth.token.email &&
          resource.data.status in ['Pending', 'Processing'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason']) &&
          request.resource.data.status == 'Canceled')
      );
      allow delete: if false;
    }

    /* Incident reports. Submit-only log, no workflow/status. */
    match /incidentReports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.reportedByEmail == request.auth.token.email;
      allow get, list: if request.auth != null;
      allow update, delete: if false;
    }

    /* Staff duty roster, one doc per (branch, date, staffAccount). Create
       is intentionally open to any authenticated user for the same
       "Team Leader isn't a custom claim" reason as leaveRequests above —
       gated to Admin/Executive Assistant/Team Leader in the CrownOS UI. */
    match /staffSchedules/{scheduleId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    /* Named recipient groups for faster Memo composing (see memos.js
       "Create Group"). Same editor set as memo composing itself. */
    match /memoGroups/{groupId} {
      allow create, update, delete: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
      allow get, list: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    /* Weekly Staff Schedule grid (Opening/Closing/Line Up rows per
       branch+week, see staff-schedule.js) — one doc per (branch,
       weekStartDate). Create/update is intentionally open to any
       authenticated user for the same "Team Leader isn't a custom claim"
       reason as staffSchedules below; gated to Admin/Executive
       Assistant/Team Leader in the CrownOS UI. Readable by everyone so a
       Therapist can see their own row. */
    match /staffScheduleGrids/{gridId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    /* Marketing / Ads Monitoring (see marketing-ads-daily.js /
       marketing-ads-summary.js). One campaign doc per campaign, with an
       append-only "entries" subcollection of dated updates underneath.
       Full CRUD, open to any authenticated user for the same "role isn't
       a custom claim" reason as staffSchedules/leaveRequests above —
       gated to Admin/Marketing Agent (plus per-user Additional Access
       grants) in the CrownOS UI. */
    match /marketingCampaigns/{campaignId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;

      match /entries/{entryId} {
        allow get, list: if request.auth != null;
        allow create, update, delete: if request.auth != null;
      }
    }

    /* Marketing / Daily Report (see marketing-daily-report.js) — one doc
       per branch per day recap. Same open-to-any-authenticated-user,
       gated-in-the-UI pattern as marketingCampaigns above. */
    match /marketingDailyReports/{reportId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    /* Client-writable notification feed for Admin Hub broadcasts
       (Announcement publish, Memo send) — kept separate from the
       Cloud-Function-only /staffNotifications above so that collection's
       server-only invariant stays intact. A recipient may only read their
       own notifications and may only ever flip "read". */
    match /staffNotificationsClient/{notificationId} {
      allow create: if request.auth != null;
      allow get, list: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail;
      allow update: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    /* One doc per registered device push token (doc ID = the token
       itself), written by push-notifications.js on opt-in. A user may
       only manage tokens addressed to their own recipientEmail; the
       Cloud Functions that actually send pushes (functions/index.js
       sendPushToAccount) use the Admin SDK and bypass these rules. */
    match /staffPushTokens/{token} {
      allow get, list: if false;
      allow create, update: if request.auth != null &&
        request.auth.token.email == request.resource.data.recipientEmail;
      allow delete: if request.auth != null &&
        request.auth.token.email == resource.data.recipientEmail;
    }
  }
}
