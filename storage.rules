rules_version = '2';

// CrownOS did not use Cloud Storage before the BIR Compliance Desk was
// added — this file is new. Cloud Storage must be enabled for the
// crownos-5f03d project in the Firebase Console (if not already) before
// uploads will work, and these rules deployed via
// `firebase deploy --only storage:rules` (or set through the console).
service firebase.storage {
  match /b/{bucket}/o {

    // BMBE certificate, per-document checklist files, and filing/payment
    // proofs uploaded from bir-compliance.html — see uploadFile() in
    // bir-compliance.js. Mirrors the birCompliance Firestore collection's
    // access rule (Admin + Executive Assistant, matched on the same
    // Firebase Auth custom claim minted by the syncMyRole Cloud Function).
    match /birCompliance/{allPaths=**} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    // Payslip attachments uploaded from payroll.js when Admin/EA click
    // "Generate Payroll" — see uploadPayrollAttachment() in payroll.js.
    // Stored one folder per owning staff member's synthetic sync email
    // (toSyncEmail(account), same identity Firebase Auth already carries
    // as request.auth.token.email — see firebase-sync.js), so that staff
    // member can read their own payslip's attachment, in addition to
    // Admin/Executive Assistant who manage payroll for everyone.
    match /payrollAttachments/{ownerSyncEmail}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.token.role in ['Admin', 'Executive Assistant'] ||
         request.auth.token.email == ownerSyncEmail);
      allow write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    // Operation Expenses receipt/proof attachments uploaded from
    // expenses-report.js — see uploadExpenseAttachment(). expenses-report.html
    // is Admin-only (access-control.js), so this mirrors that.
    match /expenseAttachments/{branch}/{fileName} {
      allow read, write: if request.auth != null &&
        request.auth.token.role == 'Admin';
    }

    // Petty Cash proof-of-payment attachments uploaded from petty-cash.js —
    // see uploadPettyCashAttachment(). This rule was missing since that
    // feature shipped (commit 63e8183), which under Storage's deny-by-default
    // behavior meant every upload attempt was silently rejected. Roles match
    // petty-cash.html's own access-control.js entry.
    match /pettyCashAttachments/{branch}/{fileName} {
      allow read, write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant', 'Receptionist'];
    }

    // Memo poster images uploaded from bulletin-board.js's Compose Memo
    // modal (uploadMemoPoster()). Read is blanket-authenticated to mirror
    // the memos Firestore collection's own read rule (see firestore.rules'
    // note on that collection: reads can't be narrowed to sender/recipient
    // at the rules level, so the client already relies on narrow queries,
    // not rule enforcement, for that). Write matches memo composing itself.
    match /memoPosters/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }

    // Announcement poster images uploaded from admin-announcement.js /
    // bulletin-board.js's announcement editor (uploadAnnouncementPoster()).
    // Same read/write split as the announcement Firestore collection.
    match /announcementPosters/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role in ['Admin', 'Executive Assistant'];
    }
  }
}
